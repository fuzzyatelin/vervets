Package: vervets
Type: Package
Title: International Vervet Research Consortium Samples and Datasets
Version: 0.1.0
Authors@R: c(person(
      "Christopher", "Schmitt",
      email = "caschmit@bu.edu",
      role = c("aut", "cre"),
